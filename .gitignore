# macOS
.DS_Store
*.swp

# Xcode (generated by xcodegen — do not commit)
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.xcuserstate
*.xcuserdatad/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Local config
*.local
.env

# Python
__pycache__/
*.pyc
.venv/

# Server runtime artifacts (only on the relay, but keep .gitignore defensive)
server/audio/
server/audio_storynory/
server/series/
server/transcripts/
server/*.log
server/*.json
server/.duration_cache.json
server/feed.xml
